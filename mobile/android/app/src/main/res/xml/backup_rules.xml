<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier. The keystore-wrapped TONE3000 session cannot be
     decrypted on another device, and downloaded models can be fetched again. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
    <exclude domain="file" path="tone3000/" />
</full-backup-content>
